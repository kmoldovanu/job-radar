# Postgres (Neon o Supabase). Usa la stringa di connessione "pooled".
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Chiave Anthropic (opzionale: senza, l'app usa solo il punteggio rapido)
ANTHROPIC_API_KEY=""

# Adzuna (gratuita su https://developer.adzuna.com)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Jooble (gratuita su https://jooble.org/api/about)
JOOBLE_API_KEY=""

# The Muse: facoltativa, alza i limiti (https://www.themuse.com/developers/api/v2)
THEMUSE_API_KEY=""

# Password per entrare nell'app
APP_PASSWORD="scegli-una-password-lunga"

# Segreto per firmare il cookie di sessione (almeno 32 caratteri casuali)
# Genera con: openssl rand -hex 32
SESSION_SECRET=""

# Opzionale: protegge /api/cron/search (Vercel lo invia come Bearer)
CRON_SECRET=""

# Opzionale: database separato per l'accesso demo (/demo), con dati di esempio.
# Senza, la demo resta spenta. Va migrato come l'altro: DATABASE_URL=<questo url> npm run db:migrate
DEMO_DATABASE_URL=
