 "narrative": {
  "northStar": "Il punto sul radar",
  "overview": "A calm, light working tool. White ground, near-black ink, and one coral that always means \"this matters\": a new offer, a strong match, the live dot.",
  "keyCharacteristics": [
   "Light always: white ground, hairline borders, cream only for summary panels.",
   "One accent, coral, used for meaning, never decoration.",
   "Mono for data (match %, dates, sources, statuses), sans for everything people read.",
   "Black pill for the one primary action per area."
  ],
  "rules": [
   {
    "name": "The One Coral Rule",
    "body": "Coral marks what deserves attention right now. If two coral things compete on one card, one of them is wrong.",
    "section": "colors"
   },
   {
    "name": "The Mono Is Data Rule",
    "body": "Mono carries numbers, dates, sources and statuses. It never sits above a heading as an eyebrow.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do keep coral for new, strong and live; everything else is ink and grey.",
   "Do put numbers, dates and sources in mono.",
   "Do show why an offer matches (\"Dal tuo CV\" + chips)."
